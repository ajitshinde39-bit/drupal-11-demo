{#
/**
 * Custom Forgot Password page.
 */
#}

<div class="login-page">

  <div class="login-card">

    <div class="login-logo">
      <!-- <a href="{{ path('<front>') }}" class="login-logo-link">

        {% if site_logo %}
          <img
            src="{{ site_logo }}"
            alt="{{ 'Home'|t }}"
          >
        {% else %}
          <span class="login-site-name">
            {{ site_name }}
          </span>
        {% endif %}

      </a> -->
        {% if page.header %}
            {{ page.header }}
        {% endif %}
    </div>

    <div class="login-content">

      <h1 class="login-title">
        {{ 'Reset Your Password'|t }}
      </h1>

      <p class="login-description">
        {{ 'Enter your username or email address. We will send you instructions to reset your password.'|t }}
      </p>

      {# Drupal messages. #}
      {% if page.messages %}
        <div class="login-messages">
          {{ page.messages }}
        </div>
      {% endif %}

      {# Drupal password reset form. #}
      {{ page.content }}

      <div class="login-help-links">
        <a href="{{ path('user.login') }}">
          ← {{ 'Back to login'|t }}
        </a>
      </div>

    </div>

  </div>

</div>