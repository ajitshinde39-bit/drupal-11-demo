<form{{ attributes }}> 
  {# {{ form_start(form) }} #}

  <div class="row">

    <div class="col-lg-6">
      <fieldset>
        {{ form.name }}
      </fieldset>
    </div>

    <div class="col-lg-6">
      <fieldset>
        {{ form.email }}
      </fieldset>
    </div>

    <div class="col-lg-12">
      <fieldset>
        {{ form.subject }}
      </fieldset>
    </div>

    <div class="col-lg-12">
      <fieldset>
        {{ form.category }}
      </fieldset>
    </div>

    <div class="col-lg-12">
      <fieldset>
        {{ form.actions }}
      </fieldset>
    </div>

  </div>

  {# REQUIRED: renders hidden elements #}
  {{ form.form_build_id }}
  {{ form.form_token }}
  {{ form.form_id }}

{# {{ form_end(form) }} #}

</form> 
