{{ form_start(form) }}

<div class="row">

  <div class="col-lg-6">
    <fieldset>
      {{ form.name }}
    </fieldset>
  </div>

  <div class="col-lg-6">
    <fieldset>
      {{ form.email }}
    </fieldset>
  </div>

  <div class="col-lg-12">
    <fieldset>
      {{ form.subject }}
    </fieldset>
  </div>

  <div class="col-lg-12">
    <fieldset>
      {{ form.category }}
    </fieldset>
  </div>

  <div class="col-lg-12">
    <fieldset>
      {{ form.actions.submit }}
    </fieldset>
  </div>

</div>

{# 🔑 THIS IS THE FIX #}
{{ form|without(
  'name',
  'email',
  'subject',
  'category',
  'actions'
) }}

{{ form_end(form) }}
