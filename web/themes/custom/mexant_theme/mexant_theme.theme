use Drupal\block\BlockPluginInterface;

/**
 * Implements hook_preprocess_block().
 */
function mexant_theme_preprocess_block(array &$variables) {

  // Target only the 'mexant-theme-copyright' block

    // Render the content to string first.
    $rendered_content = \Drupal::service('renderer')->renderPlain($variables['content']);

    // Replace placeholder {{year}} with actual current year.
    $rendered_content = str_replace('{{year}}', date('Y'), $rendered_content);

    // Set the processed content back to the render array.
    $variables['content'] = [
      '#markup' => $rendered_content,
    ];

}
