<?php

/**
 * Implements hook_theme().
 */
function product_price_theme($existing, $type, $theme, $path) {
  return [
    'product_price' => [
      'variables' => [
        'product' => NULL,
        'price' => NULL,
        'quantity' => NULL,
        'total' => NULL,
      ],
      'template' => 'product-price',
    ],
  ];
}